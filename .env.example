# Local development only. Generate a URL-safe password in your own .env file.
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
CHATBOT_APP_PORT=8000
# Optional Runflare package index for local Docker image builds; CI uses default official PyPI.
# Existing .env files require this entry to be added manually or set in PowerShell.
CHATBOT_PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple/
# Relative to compose.yaml by default; prefer a directory on D: on Windows.
CHATBOT_STORAGE_HOST_PATH=./storage
# Docker Desktop host bridge; validate connectivity on your machine.
CHATBOT_LLM_BASE_URL=http://host.docker.internal:8080
# Optional development llama.cpp API key; leave empty only on an isolated host.
CHATBOT_LLM_API_KEY=
