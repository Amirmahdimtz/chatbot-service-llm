# Local development only. Generate a URL-safe password in your own .env file.
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
CHATBOT_APP_PORT=8000
# Optional official Debian mirrors for Stage 5 OCR/LibreOffice packages.
# Set BOTH URLs to reachable trusted Debian mirrors only when default APT downloads stall.
# The URLs must point to the Debian distribution and Debian security repositories.
# CHATBOT_APT_DEBIAN_MIRROR_URL=https://deb.debian.org/debian
# CHATBOT_APT_SECURITY_MIRROR_URL=https://deb.debian.org/debian-security
# Optional Runflare package index for local Docker image builds; CI uses default official PyPI.
# Existing .env files require this entry to be added manually or set in PowerShell.
CHATBOT_PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple/
# Relative to compose.yaml by default; prefer a directory on D: on Windows.
CHATBOT_STORAGE_HOST_PATH=./storage
# Docker Desktop host bridge; validate connectivity on your machine.
CHATBOT_LLM_BASE_URL=http://host.docker.internal:8080
# Optional development llama.cpp API key; leave empty only on an isolated host.
CHATBOT_LLM_API_KEY=
# Synthetic-public Chat API credential; never reuse the LLM runtime key.
CHATBOT_DEV_API_TOKEN=

# Run separate CPU-only llama.cpp embedding / reranking servers, one at a time on 16 GB systems.
CHATBOT_EMBEDDING_BASE_URL=http://host.docker.internal:8081
CHATBOT_EMBEDDING_API_KEY=
CHATBOT_RERANKING_BASE_URL=http://host.docker.internal:8082
CHATBOT_RERANKING_API_KEY=
# Optional: Stage 5 CPU A/B evaluation; 20 preserves the full reranking baseline.
# Must be between retrieval.final (5) and retrieval.first_stage (20).
# CHATBOT_RERANK_CANDIDATES=5
CHATBOT_QDRANT_API_KEY=
